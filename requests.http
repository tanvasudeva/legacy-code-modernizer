# ──────────────────────────────────────────────────────────────────────────────
# redis-cli XLEN agent:refactorer
# redis-cli XLEN agent:test_writer
# redis-cli XLEN agent:doc_generator
# redis-cli XINFO GROUPS agent:refactorer
